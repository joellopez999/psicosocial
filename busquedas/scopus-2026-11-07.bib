@ARTICLE{Prashar2023,
	author = {Prashar, Pradeepti and Sharma, Dinesh Kumar and Mohinder, Bandana and Kumari, Santosh},
	title = {Experiences and Perspectives of Student Nurses Toward Volunteerism during Health Emergencies: A Systematic Review},
	year = {2023},
	journal = {Indian Journal of Psychiatric Nursing},
	volume = {20},
	number = {2},
	pages = {},
	doi = {10.4103/iopn.iopn_59_23},
	url = {https://www.scopus.com/pages/publications/105053739301?origin=resultslist},
	abstract = {The paper discusses how volunteerism, especially among nursing students, helps solve health crises. The study emphasizes community preparedness and volunteers’ unique role in supporting healthcare professionals during crises. Volunteers seek out opportunities to help, unlike emergency responders. Nursing students, a major employment source, are shown to be capable of first aid and emotional support. The COVID-19 pandemic highlights the unprecedented need for volunteers. Research shows that nursing students worldwide are willing to help in health emergencies. Professional ethics, humanity, and learning motivate. Self-care issues, system support issues, and psychological impacts are obstacles. The study uses a mixed-methods technique and the PRISMA framework to examine nursing students’ health crisis volunteering experiences, goals, and perceptions. The data show volunteer nursing students’ pleasures and problems. Although volunteering is rewarding, worries about self-care, family well-being, and psychological effects arise. Emotional stress, burnout, compassion fatigue, anxiety, sleep difficulties, guilt, and a lack of support affect nursing students’ mental health. Witnessing and experiencing health emergencies can cause emotional stress, highlighting the need for personalized solutions. The report recommends cash incentives, extensive training, and explicit protocols to increase student volunteering. Nursing students can safely volunteer in high-stress situations by recognizing and addressing the mental health risks and providing support and tools. The article recommends a holistic approach to volunteerism that recognizes its benefits and promotes the mental health and well-being of motivated nursing students. Nursing students helping in health emergencies need sufficient training, psychological support, and self-care to protect their mental health, according to the study. Providing support, shifting schedules, and understanding the emotional toll of employment are vital. Nursing schools should include emergency response training to prepare students for pandemic leadership. Copyright: © 2023 Indian Journal of Psychiatric Nursing},
	author_keywords = {Experiences; health emergencies; student nurses; volunteering; willingness},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Lin2026,
	author = {Lin, Zhuyun and Chan, Iris K. N. and Lou, Vivian Weiqun},
	title = {Development and Preliminary Validation of an Emotional Readiness Tool for End-of-Life Care Volunteers},
	year = {2026},
	journal = {Healthcare (Switzerland)},
	volume = {14},
	number = {20},
	pages = {},
	doi = {10.3390/healthcare14203505},
	url = {https://www.scopus.com/pages/publications/105055006713?origin=resultslist},
	abstract = {Background: Volunteers play an important role in community-based end-of-life care (EoLC), yet few structured approaches are available to identify prospective volunteers’ emotional support and preparation needs before service engagement. This study developed and preliminarily evaluated an Emotional Readiness Tool (ERT) as a profile-based screening framework. Methods: A cross-sectional study was conducted among 1372 adults who registered for a community-based EoLC volunteer training programme between 2022 and 2024. The 13-indicator ERT covers emotional regulation capacities, death-related experiences, and interpersonal capacities. Exploratory factor analysis (EFA), component-specific internal consistency analysis, correlations with external psychological measures, and exploratory subgroup comparisons were conducted. Results: The sample was predominantly female and highly educated. EFA identified coherent clusters among perceived stress and depressive symptom indicators, whereas death-related and interpersonal indicators did not form common latent factors. Because the ERT combines indicators with different response formats and does not currently provide a validated overall score, cutoff, or suitability classification rule, the factor analysis was interpreted as an exploratory examination of association patterns rather than confirmation of a unified latent structure. Emotional regulation capacities were associated with death anxiety and holistic well-being, while demographic differences were generally small. Conclusions: The ERT is best understood as a multidimensional, profile-based screening framework rather than a conventional psychometric scale. It may support individualized discussion, training, supervision, and role matching, but should not be used as a diagnostic, gatekeeping, or exclusion tool. Further research should evaluate its temporal stability and predictive and criterion-related utility. © 2026 by the authors.},
	author_keywords = {emotional readiness; end-of-life care; screening tool; volunteer assessment},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

