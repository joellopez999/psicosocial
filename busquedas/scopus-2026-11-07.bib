}

@ARTICLE{Lühr20221969,
	author = {Lühr, Matthias and Pavlova, Maria K. and Luhmann, Maike},
	title = {They are Doing Well, but is it by Doing Good? Pathways from Nonpolitical and Political Volunteering to Subjective Well-Being in Age Comparison},
