@ARTICLE{Talebi2026,
	author = {Talebi, Zahra and Ebadi, Abbas and Mahmoodi-Shan, Gholamreza and Behnampour, Naser},
	title = {Spiritual Beliefs and Divine Motivation Among Disaster-Volunteering Nurses: A Qualitative Study},
