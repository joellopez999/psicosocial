}

@ARTICLE{Chen202513339,
	author = {Chen, Jing and Tang, Yulong and Wang, Chengliang},
	title = {Motivation and mechanism of university volunteers’ participation in major sport events: a grounded theory study on volunteers for the Hangzhou Asian games},
