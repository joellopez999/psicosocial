@ARTICLE{Counson2023410,
	author = {Counson, I. and Sanatkar, S. and Knight, A. and Lawrence, D. and Harvey, S.B.},
	title = {Comparing post-traumatic stress severity in professional and volunteer Australian firefighters},
	year = {2023},
	journal = {Occupational Medicine},
	volume = {73},
