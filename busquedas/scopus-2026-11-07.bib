@ARTICLE{García2019391,
	author = {García, Maria Begoña and Silva, Jose Luis and Tejero, Pablo and Pardo, Iker and Gómez, Daniel},
	title = {Tracking the long-term dynamics of plant diversity in Northeast Spain with a network of volunteers and rangers},
	year = {2019},
