	author = {Hohneck, Anna and Reyser, Christina and Usselmann, Rimma and Heinemann, Lara and Weingaertner, Simone and Reckling, Hardy and Schumacher, Gerhard and Burkholder, Iris and Merx, Kirsten and Hofmann, Wolf-Karsten and Hofheinz, Ralf-Dieter},
	title = {Hemodynamic and Stress Response After Sound Intervention with Different Headphone Systems: A Double-Blind Randomized Study in Healthy Volunteers Working in the Health Care Sector},
