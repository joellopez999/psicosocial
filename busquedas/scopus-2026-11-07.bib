@ARTICLE{Katkhaw2025359,
	author = {Katkhaw, Orathai and Juwa, Somkid and Srisookkum, Taweewun and Takaew, Tienthong and Tangnitipong, Sunanta and Chairinkam, Surangkana},
	title = {Developing a Participatory Resilience Quotient Program for Village Health Volunteers in Rural Thailand: An Action Research Study in the Post-COVID-19 Era},
	year = {2025},
	journal = {Journal of Health Research},
