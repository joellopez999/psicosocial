@ARTICLE{Powers2025,
	author = {Powers, Sammie L. and Trauntvein, Nate and Covelli Metcalf, Elizabeth and Whicher, Meg R.},
	title = {Fostering long-term commitment among certified career volunteers in outdoor adventure recreation: integrating role identity in the volunteer process model for ski patrollers},
