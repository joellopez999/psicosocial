@ARTICLE{Tamura2024,
	author = {Tamura, Motoki and Nakagomi, Atsushi and Ide, Kazushige and Kondo, Katsunori and Ojima, Toshiyuki and Takasugi, Tomo and Shiba, Koichiro},
	title = {Volunteer group participation and subsequent health and well-being among older adults in Japan: An outcome-wide longitudinal approach},
