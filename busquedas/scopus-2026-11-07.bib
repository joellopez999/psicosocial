@ARTICLE{Iverson2024,
	author = {Iverson, Thomas and Alfares, Hadil and Nijjar, Gurkirat Singh and Wong, Jeffrey and Abbasi, Emaan and Esfandiari, Elham and Lin, Margaret and Petrella, Robert J. and Symes, Bobbi and Chudyk, Anna and Ashe, Maureen C.},
	title = {A rapid systematic review of the effect of health or peer volunteers for diabetes self-management: Synthesizing evidence to guide social prescribing},
	year = {2024},
