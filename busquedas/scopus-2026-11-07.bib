@ARTICLE{Amato2025,
	author = {Amato, Simone and Giordano, Vincenza and Cascio, Alessio Lo and Napolitano, Daniele and Gravante, Francesco and Giannetta, Noemi and Parozzi, Mauro and Bozzetti, Mattia and Arcadi, Paola and Figura, Mariachiara},
