@ARTICLE{Lo2026,
	author = {Lo, Jin},
	title = {From Surge to Sustained Commitment: Role/Responsibility Internalization in Postdisaster Digital Volunteer Collaboration},
	year = {2026},
	journal = {Nonprofit Management and Leadership},
	pages = {},
	doi = {10.1002/nml.70075},
	url = {https://www.scopus.com/pages/publications/105053285864?origin=resultslist},
	abstract = {This study examines the structural conditions under which postdisaster digital volunteer collaboration is associated with continuance commitment beyond surge-like mobilization. Using a cross-sectional online survey in a semi-closed volunteer coordination community, the study estimates a PLS-SEM model examining the structural associations among prosocial/value-oriented motivation, role/responsibility internalization, trust, and continuance commitment. Results indicate significant direct associations of prosocial/value-oriented motivation and internalization with continuance commitment, along with a significant specific indirect association from motivation via internalization (partial mediation). Trust shows no significant direct association in the structural model, suggesting it may function more as a proximal condition for entering coordination than as an anchor of continuance commitment. Overall, the findings highlight role/responsibility internalization as a role-based identification and responsible self-positioning construct associated with stronger continuance commitment in informal, high-uncertainty postdisaster digital collaboration, offering a more differentiated account of commitment formation beyond initial mobilization surges. © 2026 The Author(s). Nonprofit Management & Leadership published by Wiley Periodicals LLC.},
	author_keywords = {continuance commitment; digital volunteer collaboration; postdisaster volunteering; role/responsibility internalization; volunteer management},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Cox2021207,
	author = {Cox, Kay L. and Clare, Linda and Cyarto, Elizabeth V. and Ellis, Kathryn A. and Etherton-Beer, Christopher and Southam, Jenny and Ames, David and Flicker, Leon and Almeida, Osvaldo P. and Logiudice, Dina and Liew, Danny and Vlaskovsky, Philip and Lautenschlager, Nicola T. and Hauer, Klaus},
	title = {A Randomized Controlled Trial on the Effects of a 6-Month Home-Based Physical Activity Program with Individual Goal-Setting and Volunteer Mentors on Physical Activity, Adherence, and Physical Fitness in Inactive Older Adults at Risk of Cognitive Decline: The INDIGO Study},
	year = {2021},
	journal = {Journal of Alzheimer's Disease},
	volume = {84},
	number = {1},
	pages = {207 - 226},
	doi = {10.3233/JAD-210479},
	url = {https://www.scopus.com/pages/publications/85118919129?origin=resultslist},
	abstract = {Background: Increasing physical activity (PA) in those who have memory concerns requires innovative approaches. Objective: To compare in this randomized controlled trial (RCT) the effects on PA, adherence, and fitness of two approaches to deliver a 6-month home-based PA program in older, inactive individuals at risk of cognitive decline. Methods: Individuals (n=52) aged 60-85 years, inactive with mild cognitive impairment or subjective cognitive decline were recruited from the community and memory clinics. Randomization was to 6 months of 150min/week moderate intensity PA with either: goal-setting with mentor support; or education and peer contact. A subset of participants (n=36) continued for a further 6 months. PA, moderate and vigorous PA, and secondary outcomes, fitness, goal performance/satisfaction and self-efficacy were assessed at baseline, 6 and 12 months. Modelling of primary and secondary outcomes was conducted with linear mixed models. Results: Participants were mean age (±sd) 70.1 (6.4) years. Six-month retention was 88.5%(n=46). No significant between-group differences were observed for PA or fitness. Post-hoc combined group data showed a significant, moderate-large effect size increase in PA with time. PA increased by a mean 1,662 (943, 2383) steps/day (95%CI) and 1,320 (603, 2037) steps/day at 6 and 12 months (p<0.001). Median (quartiles Q1-Q3) 6 and 6-12 month combined group adherence was 88.9 (74.4-95.7)%and 84.6 (73.9-95.4)%respectively. Conclusion: In this target group, no differences were detected between groups both intervention strategies were highly effective in increasing PA and fitness.  © 2021 - IOS Press. All rights reserved.},
	author_keywords = {Aged; cognitive dysfunction; exercise; goals; mentors; physical fitness; sedentary behavior; volunteers},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9}
}

@ARTICLE{Skuse2025,
	author = {Skuse, Andrew and Reid, Alison},
	title = {Mapping the ‘Crowd’: Volunteer Crisis Mappers and Digital Humanitarianism},
	year = {2025},
	journal = {Journal of Contingencies and Crisis Management},
	volume = {33},
	number = {4},
	pages = {},
	doi = {10.1111/1468-5973.70103},
	url = {https://www.scopus.com/pages/publications/105024807732?origin=resultslist},
	abstract = {Digital humanitarianism represents an increasingly important aspect of wider humanitarian aid processes. Here, crisis mapping, which draws on international, largely Northern, volunteers utilising crowdsourced data drawn from disaster-affected communities, largely in the South, is perhaps its most well-known form. Such practices have been subject to critiques concerning power dynamics, the motivations of international volunteers and the relative inequalities faced by participants, especially in crisis-affected contexts. Our analysis utilises such critiques to probe the role volunteers play in the mapping nexus. In doing so, we examine volunteer perceptions of the skills-building processes offered by mapping organizations through which, volunteers attempt to build the necessary capacity to undertake their work. Subsequently, we examine volunteer engagement in the practice of mapping itself. In doing so, we consider the nature of individual labour commitments to mapping and perceptions of organizational cohesion. Finally, we focus on what motivates volunteers to get involved, as well as perceptions of impact. Despite mapping constituting a highly technocratic process, we conclude that the volunteer community of mappers is dynamic and inherently complex and not easy to label. Further, the nature of the mapping sector's organization can be considered as a positive boon to their sustainability and continued relevance. © 2025 John Wiley & Sons Ltd.},
	author_keywords = {crisis; crowd; disaster; humanitarianism; mapping; volunteer},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Höing2016364,
