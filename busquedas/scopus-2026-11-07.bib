@ARTICLE{Keicher2021,
	author = {Keicher, Christian and Pyrkosch, Lena and Wolfarth, Bernd and Ströhle, Andreas},
	title = {Psychological Effects of Whole-body Electromyostimulation Training: a Controlled Pilot Study in Healthy Volunteers},
