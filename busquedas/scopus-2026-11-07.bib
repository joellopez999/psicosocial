	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 8; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Mueller2026,
	author = {Mueller, Sonja and Stavrianaki, Katerina and Boscor, Andrei and Saville, Naomi and Arjyal, Abriti and Baral, Sushil C. and Fordham, Maureen and Hearn, Gareth and Kostkova, Patty},
	title = {MANTRA game analytics: effectiveness of educational mobile game on knowledge gain and retention of Female Community Health Volunteers (FCHVs) and women in rural Nepal assessed through game analytics},
	year = {2026},
	journal = {BMC Public Health},
	volume = {26},
