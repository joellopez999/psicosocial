@ARTICLE{Stapel2021422,
	author = {Stapel, B. and Nösel, P. and Heitland, I. and Mahmoudi, N. and Lanfermann, H. and Kahl, K.G. and Ding, X.Q.},
	title = {In vivo magnetic resonance spectrometry imaging demonstrates comparable adaptation of brain energy metabolism to metabolic stress induced by 72 h of fasting in depressed patients and healthy volunteers},
