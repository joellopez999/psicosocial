@ARTICLE{Jannat2023,
	author = {Jannat, Forouzandeh and Khorasani-Zavareh, Davoud and Allahbakhshi, Kiyoumars and Aghazadeh-Attari, Javad and Nateghinia, Saeedeh and Mohebbi, Iraj},
	title = {The Policy Gap and Inefficiency in Public Volunteers' Response to Assist the Hospitals After Natural Disasters in Iran: A Grounded Theory Methodology},
	year = {2023},
