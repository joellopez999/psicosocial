@ARTICLE{Chan201785,
	author = {Chan, Aileen W. K. and Yu, Doris S. F. and Choi, K.C.},
	title = {Effects of tai chi qigong on psychosocial well-being among hidden elderly, using elderly neighborhood volunteer approach: A pilot randomized controlled trial},
	year = {2017},
