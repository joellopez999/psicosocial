@ARTICLE{Niu2026,
	author = {Niu, Cheng-Cheng and Wu, Ke and Yu, Jing},
	title = {Single-session volunteering reduces loneliness in older adults: immediate and long-term effects},
	year = {2026},
	journal = {Gerontologist },
