@ARTICLE{Gu2023,
	author = {Gu, Liyan and Liu, Fengmei and Wang, Ji and Li, Jie and Wei, Jie and Xu, Jiping},
	title = {Stress load and volunteer motivation of patient volunteers in Fangcang shelter hospitals in Shanghai, China during the COVID-19 pandemic: A cross-sectional survey},
	year = {2023},
	journal = {BMJ Open},
	volume = {13},
	number = {4},
