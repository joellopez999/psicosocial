@ARTICLE{Cherven2020136,
	author = {Cherven, Brooke and Jordan, Dorothy and Hale, Sally and Wetzel, Martha and Travers, Curtis and Smith, Kylie},
	title = {Nurse–Patient Connectedness and Nurses’ Professional Quality of Life: Experiences of Volunteering at a Pediatric Oncology Camp},
