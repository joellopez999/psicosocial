	volume = {16},
	number = {4},
	pages = {},
	url = {https://www.scopus.com/pages/publications/105053334794?origin=resultslist},
	abstract = {Volunteering has become an increasingly significant area of engagement in higher education. The introduction of volunteering courses at public universities represents an important initiative to cultivate a spirit of community engagement among students. Reliance solely on theoretical learning and classroom-based instruction is increasingly considered insufficient; instead, there is a growing need for students to actively connect with communities through volunteer activities. This study was conducted to assess the level of student motivation and the suitability of the Volunteering course in enhancing students’ cooperative spirit and their capacity for community engagement. At Sultan Idris Education University (UPSI), undergraduate students are required to enroll in the Volunteering course as part of their academic program. This requirement not only reinforces the university’s role as a leading institution in producing educators in Malaysia but also reflects UPSI’s commitment to addressing students’ needs for meaningful community engagement. The study employed a quantitative research design involving 442 students who were enrolled in the Volunteering course during Semester A212 at Sultan Idris Education University. Data were collected through the distribution of structured questionnaires. The findings indicate that students hold positive perceptions regarding the implementation of the course at the university. The course has contributed to increased motivation among students, improved task performance through collaborative group work, and enhanced communication skills as well as a deeper understanding of social work practices. It is anticipated that the findings of this study will contribute to the development of a structured volunteering module that can be implemented across public universities in Malaysia. © RJ4All 2026 © 2026 RESTORATIVE JUSTICE FOR ALL.},
	author_keywords = {Education; Motivation; Social Work; Students; Volunteering},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Ho2024158,
	author = {Ho, Yun-Chi and Kao, Sheng-Po and Chen, Che-Han and Chu, Shao-Yin},
	title = {Older Taiwanese Volunteers as Standardized Patients: Service Motivation, Identity Formation, and Internal Transformation},
	year = {2024},
	journal = {Simulation in Healthcare},
	volume = {19},
	number = {3},
	pages = {158 - 163},
	doi = {10.1097/SIH.0000000000000754},
	url = {https://www.scopus.com/pages/publications/85194974359?origin=resultslist},
	abstract = {Introduction Most standardized patients (SPs) in Taiwan are middle-aged or older volunteers with a high retention rate and selflessly devote themselves to the service. This study explored the psychological process behind the continued altruistic behaviors of SPs to understand the formation of service motivation, professional identity, and internal transformation. Methods Sixteen volunteers, aged 50 to 70 years, who served as SPs for 3 to 11 years in a religious hospital were enrolled in this study. Individual semistructured interviews were conducted. Each person was interviewed for approximately 120 minutes. We used a thematic analysis to analyze the interview transcripts. Results We identified 3 major themes and 8 subthemes. The first theme, SPs' service motivation, included the following 3 subthemes: past medical experiences, acquisition of medical knowledge, and emotional connections. The second theme, SPs' identity formation, included the following 3 subthemes: role recognition, work ethic, and a sense of religious mission. The third theme, SPs' physical and psychological support, included 2 subthemes: internal transformation and personal well-being. Conclusions The interview results showed doctor-patient or life experiences served as the impetus prompting SPs to engage in such altruistic behavior. In addition, identity formation endowed older SPs with a life purpose and a sense of fulfillment and self-actualization through fostering and training medical students. In addition, a clear recognition of the role of an SP and self-worth helped volunteers mitigate any physical and mental problems caused by negative life experiences. Standardized patients continued to complete their tasks with a positive attitude.  © 2023 The Author(s).},
	author_keywords = {identity formation; internal transformation; middle-aged and older volunteers; service motivation; standardized patient},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
