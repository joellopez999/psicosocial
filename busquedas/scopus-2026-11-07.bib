@ARTICLE{Junaidi202580,
	author = {Junaidi, Said. and Rahayu, Tandiyo. and Castyana, Billy. and Okade, Yoshinori. and Syamsul Taufik, Muhammad and Surono and Suswantoro, Gunawan. and Riska Pengesti, Nesa and Sunanto and Putri Purwoto, Septyaningrum},
