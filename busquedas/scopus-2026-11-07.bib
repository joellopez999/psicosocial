@ARTICLE{Ma202626,
	author = {Ma, Minqin and Chen, Yi-Ru Regina},
	title = {Strategic communication to motivate corporate volunteering participation among Chinese employees: a comparison of state-owned and private enterprises for social impact},
	year = {2026},
	journal = {Journal of Communication Management},
	volume = {30},
