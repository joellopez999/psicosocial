@ARTICLE{Kim2026,
	author = {Kim, Soojin and Lee, Jeonghee and Lee, Sugwang},
	title = {Sustainable Management of National Forest Trails: Structural Relationships Among Volunteer Motivation, Satisfaction, Perceived Quality of Life, and Active Participation Intention},
	year = {2026},
