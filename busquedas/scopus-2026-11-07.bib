@ARTICLE{Gür-Erdoğan20261,
	author = {Gür-Erdoğan, Duygu and Kaya-Uyanık, Gülden and Canan Güngören, Özlem},
	title = {Volunteering motivation and sustainable development awareness as predictors of preservice teachers' personal social responsibility},
	year = {2026},
