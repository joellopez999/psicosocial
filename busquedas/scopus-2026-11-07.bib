@ARTICLE{Ballard2022,
	author = {Ballard, Parissa J. and Daniel, Stephanie S. and Anderson, Grace and Koehler, Aubry N. and Caballero Quinones, Elimarie and Strahley, Ashley and Nicolotti, Linda M.},
