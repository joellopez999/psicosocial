@ARTICLE{Milligan-Saville20181110,
	author = {Milligan-Saville, Josie and Choi, Isabella and Deady, Mark and Scott, Paul and Tan, Leona and Calvo, Rafael A. and Bryant, Richard A. and Glozier, Nicholas and Harvey, Samuel B.},
	title = {The impact of trauma exposure on the development of PTSD and psychological distress in a volunteer fire service},
