@ARTICLE{May2026325,
	author = {May, Ellie L.},
	title = {Exploring the Volunteer Experience at the London 2012 Paralympics and Beyond},
	year = {2026},
	journal = {Event Management},
	volume = {30},
	number = {3},
	pages = {325 - 351},
	doi = {10.3727/152599525X17525390697508},
	url = {https://www.scopus.com/pages/publications/105040695149?origin=resultslist},
	abstract = {Using the Volunteer Process Model (VPM) as a framework, this qualitative study explores the volunteer journey at the London 2012 Paralympics. Based on 91 interviews with 26 volunteers across four stages (before, during, after, and 12 months post-Games), the research examines motivations, lived experiences, and postevent engagement. The study contributes to theory by extending the VPM to a parasport context, revealing how limited awareness and perceptions of the Paralympics shaped expectations. However, the event atmosphere—described as a Paralympic utopia—and interactions with athletes fostered positive experiences. Two post-Games engagement patterns emerged: habitual episodic and those returning to preexisting commitments. The findings highlight the importance of disability and parasport awareness and training in enhancing satisfaction. Moreover, the study shows positive experiences can promote future volunteer engagement, particularly through flexible, episodic opportunities that accommodate diverse lifestyles. These insights inform both theoretical understanding and strategies for managing volunteers at parasport mega-events. Copyright © 2026 Cognizant, LLC.},
	author_keywords = {Longitudinal research; Mega-events; Paralympic Games; Paralympics; Qualitative research; Volunteer Process Model; Volunteering},
