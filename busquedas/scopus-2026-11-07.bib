@ARTICLE{Tomer202438,
	author = {Tomer, Abhilasha and Sarkar, Amlan Kanti and Chitme, Havagiray R.},
	title = {Impact of dietary and herbal supplements on global health of adult volunteers},
	year = {2024},
	journal = {Current Issues in Pharmacy and Medical Sciences},
	volume = {37},
