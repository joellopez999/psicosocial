@ARTICLE{Halperin2026,
	author = {Halperin, Donna M. and Selig, Bailey M. and Condran, Brian R. J. and Davis, Alexa J. and Whittle, Carrie A. and Langley, Joanne M. and Halperin, Scott A.},
	title = {More than a moment: Evolving decisions among eligible volunteers in phase 1 COVID-19 vaccine trials},
	year = {2026},
	journal = {Human Vaccines and Immunotherapeutics},
	volume = {22},
	number = {1},
	pages = {},
	doi = {10.1080/21645515.2026.2724632},
	url = {https://www.scopus.com/pages/publications/105050207184?origin=resultslist},
	abstract = {Phase 1 vaccine trials rely on healthy participants who accept uncertainty with limited or no personal health benefit. Why people join and why they stay until trial completion is underexplored. Using a modified grounded theory approach, we examined decision making among eligible individuals who enrolled (trial participants (TPs), n = 32) and those that declined enrollment (non-participants (NPs), n = 5) across two phase 1 COVID-19 vaccine trials conducted during the pandemic (Nova Scotia, Canada; 2021–2023). Semi-structured qualitative interviews were carried out at enrollment or non-enrollment (both groups) and trial completion (TPs only). Transcripts were analyzed with open, focused, and theoretical coding, constant comparison, and memo writing to develop a grounded conceptual account of decision making during a trial. Analysis revealed a core analytic category, Harmonizing Self and Circumstances Amid a Pandemic. Within this broader category, two overlapping and interconnected categories of decision making emerged: Deciding Whether to Enroll, that involved balancing personal benefits, circumstances, and altruistic aims and; Revisiting Participation as Circumstances Changed, shaped by the rollout of Public Health approved vaccines (PHAVs), vaccine mandates, and COVID-19 case counts. A mid-trial protocol adaptation allowing participants to receive a PHAV supported retention until trial completion. NPs prioritized immediate access to a PHAV. Participation in phase 1 vaccine trials was a fluid process rather than a single decision, where motivations, concerns, and priorities were continuously reevaluated with shifting personal, trial, and pandemic circumstances. Future trials should anticipate changing contexts, communicate clearly about informed consent and data integrity when standard-of-care vaccines emerge, and incorporate flexible trial adaptations. © 2026 The Author(s). Published with license by Taylor & Francis Group, LLC.},
	author_keywords = {COVID-19 pandemic; decision making; modified grounded theory; motivations; phase 1 vaccine trials; public health; qualitative research; Volunteer participants},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Fitzgibbon2026,
	author = {Fitzgibbon, Paul and Barber, Olivia},
	title = {Exploring Volunteer Therapy Dog Handlers’ Intention to Continue Their Service Using the Theory of Planned Behavior},
	year = {2026},
	journal = {Anthrozoos},
	pages = {},
	doi = {10.1080/08927936.2026.2724667},
	url = {https://www.scopus.com/pages/publications/105052257972?origin=resultslist},
	abstract = {Volunteer therapy dog handlers play a vital role in many types of canine-assisted services, and while previous research suggests that distinct factors may influence the sustained volunteerism of this understudied population, these determinants remain unclear. Therefore, this study of 216 volunteer therapy dog handlers investigated the utility of the theory of planned behavior framework, widely utilized in general volunteerism research yet untested in this context, to predict their intention to continue serving in canine-assisted services. Participants completed quantitative and qualitative assessments in an online survey about continuing their volunteering. The quantitative evaluation of the utility of the framework to explain intention to continue serving was integrated with a qualitative analysis of participants’ beliefs relating to concepts of the theory, providing explanatory depth and context to the findings. Multiple regression analysis provided support for the theory of planned behavior as a valid model for volunteer therapy dog handlers’ behavioral intention to continue volunteering. Attitude emerged as the strongest predictor of intention, whilst subjective norm did not significantly predict intention. Intention was determined by perceived ease of continuing service, rather than perceptions of volitional control. Thematic analysis of participants’ beliefs suggested attitudes were shaped by the fulfillment of cooperating egoistic, collectivistic, and altruistic motivations. Social impact on intention was driven by relationships rather than conformity. Perceptions of behavioral control were influenced by participants’ current circumstances rather than anticipation of future barriers. Therefore, the findings suggest that the theory of planned behavior provided a useful framework for understanding volunteer therapy dog handlers’ intention to continue their service and that volunteer therapy dog handler retention strategies should address a set of cooperating motivational factors and enable practical measures to facilitate continued participation. Recommendations for future research were made addressing dog welfare and further aspects of volunteerism in this context. © 2026 The Author(s). Published by Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {Canine-assisted intervention; human–animal interaction; sustained volunteerism; visiting dog; volunteer motivation; volunteer retention},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

