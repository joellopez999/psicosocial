@ARTICLE{Mulatero20232483,
	author = {Mulatero, Paolo and Groessl, Michael and Vogt, Bruno and Schumacher, Christoph and Steele, Ronald Edward and Brooks, Ashley and Hossack, Stuart and Brunner, Hans-Rudolf},
	title = {CYP11B2 inhibitor dexfadrostat phosphate suppresses the aldosterone-to-renin ratio, an indicator of sodium retention, in healthy volunteers},
	year = {2023},
	journal = {British Journal of Clinical Pharmacology},
	volume = {89},
