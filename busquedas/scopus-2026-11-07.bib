@ARTICLE{Varay2024754,
	author = {Varay, Caroline and Lareyre, Olivier and Baeza-Velasco, Carolina},
	title = {Are Palliative Care Volunteers Special People? A Comparative Observational Study Exploring Their Sociodemographic Profile and Psychological Resources},
