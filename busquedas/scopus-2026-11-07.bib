@ARTICLE{Gómez-Durán2022,
	author = {Gómez-Durán, Esperanza L. and Fumadó, Carles Martin and Gassó, Aina M. and Díaz, Sandra and Miranda-Mendizabal, Andrea and Forero, Carlos G. and Virumbrales, Montserrat},
