@ARTICLE{Pöyhiä2019493,
	author = {Pöyhiä, Reino and Jaatinen, Anna and Niemi-Murola, Leila and Mtega, Aida and Mpumilwa, Godfrey and Mmbando, Paul},
	title = {Palliative Care Volunteers Have High Workload but No Burnout: A Questionnaire Survey from Tanzania},
