@ARTICLE{Johnson201859,
	author = {Johnson, Michelle L. and Campbell, Lindsay K. and Svendsen, Erika S. and Silva, Philip},
	title = {Why count trees? Volunteer motivations and experiences with tree monitoring in New York City},
