@ARTICLE{Potipiroon2025346,
	author = {Potipiroon, Wisanupong and Tongsongsom, Kridnawin},
	title = {A double-edged sword of prosocial motivation: the influence of perceived leader and team prosocial motivation on rescue volunteers’ work engagement and job burnout},
