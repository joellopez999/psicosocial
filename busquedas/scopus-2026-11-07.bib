@ARTICLE{Varay202521,
	author = {Varay, C. and Baeza-Velasco, C.},
	title = {Nurturing palliative care volunteers’ well-being: A quasi-randomized controlled trial evaluating an online positive activity program designed to improve psychosocial functioning; [Soutenir le bien-être des bénévoles en soins palliatifs : un essai contrôlé quasi randomisé évaluant un programme en ligne d'activités positives destiné à améliorer le fonctionnement psychosocial]},
	year = {2025},
