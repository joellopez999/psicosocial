@ARTICLE{Pesut2020,
	author = {Pesut, Barbara and Duggleby, Wendy and Warner, Grace and Bruce, Paxton and Ghosh, Sunita and Holroyd-Leduc, Jayna and Nekolaichuk, Cheryl and Parmar, Jasneet},
	title = {A mixed-method evaluation of a volunteer navigation intervention for older persons living with chronic illness (Nav-CARE): findings from a knowledge translation study},
	year = {2020},
	journal = {BMC Palliative Care},
	volume = {19},
	number = {1},
	pages = {},
	doi = {10.1186/s12904-020-00666-2},
	url = {https://www.scopus.com/pages/publications/85092743521?origin=resultslist},
	abstract = {Background: Volunteer navigation is an innovative way to help older persons get connected to resources in their community that they may not know about or have difficulty accessing. Nav-CARE is an intervention in which volunteers, who are trained in navigation, provide services for older persons living at home with chronic illness to improve their quality of life. The goal of this study was to evaluate the impact of Nav-CARE on volunteers, older persons, and family participating across eight Canadian sites. Methods: Nav-CARE was implemented using a knowledge translation approach in eight sites using a 12- or 18-month intervention period. A mixed method evaluation was used to understand the outcomes upon older person engagement; volunteer self-efficacy; and older person, family, and volunteer quality of life and satisfaction with the intervention. Results: Older persons and family were highly satisfied with the intervention, citing benefits of social connection and support, help with negotiating the social aspects of healthcare, access to cost-effective resources, and family respite. They were less satisfied with the practical help available for transportation and errands. Older persons self-reported knowledge of the services available to them and confidence in making decisions about their healthcare showed statistically significant improvements (P <.05) over 12–18 months. Volunteers reported satisfaction with their role, particularly as it related to building relationships over time, and good self-efficacy. Volunteer attrition was a result of not recruiting older persons in a timely manner. There was no statistically significant improvement in quality of life for older persons, family or volunteers from baseline to study completion. Conclusions: Findings from this study support a developing body of evidence showing the contributions volunteers make to enhanced older person and family well-being in the context of chronic illness. Statistically significant improvements were documented in aspects of client engagement. However, there were no statistically significant improvements in quality of life scores even though qualitative data illustrated very specific positive outcomes of the intervention. Similar findings in other volunteer-led intervention studies raise the question of whether there is a need for targeted volunteer-sensitive outcome measures. © 2020, The Author(s).},
	author_keywords = {Family caregivers; Hospice; Navigation; Older persons; Palliative; Quality of life; Volunteers},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 20; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Abdulle2026,
	author = {Abdulle, Abdinasir Muhidin and Hidigow, Abdishakur Mohamud Hassan},
	title = {Unpaid Clinical “Volunteer” Roles in Low- and Middle-Income Health Systems: A Narrative Review of Workforce Governance and Patient Safety},
	year = {2026},
	journal = {Journal of Healthcare Leadership},
	volume = {18},
	pages = {},
	doi = {10.2147/JHL.S634507},
	url = {https://www.scopus.com/pages/publications/105053461704?origin=resultslist},
	abstract = {Unpaid or unsalaried clinical “volunteer” roles are an underexamined workforce-governance issue in low- and middle-income countries (LMICs). This narrative review synthesized evidence on unpaid and unsalaried clinical work, labour-market transition, health-system governance, health-worker wellbeing, and patient safety. Targeted searches of PubMed, Google Scholar, World Health Organization (WHO), International Labour Organization (ILO), Cochrane, and grey-literature sources from 2000 to 2026 yielded 22 substantive sources: seven empirical or context-specific studies, six evidence reviews, and nine policy, technical, or country documents. Eight sources directly or closely described unpaid, unsalaried, volunteer, or transition-to-employment clinical roles. Evidence from Somalia, Sierra Leone, Nigeria, and Kenya confirms that such arrangements occur in several LMIC settings, although their prevalence and forms in private facilities remain poorly characterized. Across the wider evidence base, constrained employment absorption, weak supervision, poor working conditions, burnout, turnover, and limited reporting capacity are associated with workforce instability and patient-safety risk. The review develops a cautious framework linking enabling labour-market and governance conditions to workforce harms and plausible safety pathways, while distinguishing directly observed findings from contextual evidence. Clear role definitions, written documentation, supervision, worker protection, accountability, and setting-specific empirical research are priorities for healthcare leaders and regulators. © 2026 Abdulle and Hidigow.},
	author_keywords = {health governance; health worker wellbeing; health workforce; healthcare leadership; low- and middle-income countries; patient safety; unpaid labour},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

